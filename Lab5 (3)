#include <iostream>
using namespace std;

int main() {
    for (int a = 0; a <= 13; a++) {
        for (int b = 0; b <= 6; b++) {
            for (int c = 0; c <= 3; c++) {
                if (5*a + 10*b + 20*c == 65) {
                    cout << "Купюр по 5 грн: " << a
                         << ", по 10 грн: " << b
                         << ", по 20 грн: " << c << endl;
                }
            }
        }
    }

    return 0;
}
