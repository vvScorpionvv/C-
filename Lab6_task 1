#include <iostream>
#include <vector>
#include <cmath>

using namespace std;

int main() {
    int n;
    cout << "Введіть кількість елементів масиву: ";
    cin >> n;

    if (n <= 0) {
        cout << "Кількість елементів має бути додатною." << endl;
        return 0;
    }

    vector<double> a(n);
    cout << "Введіть " << n << " дійсних чисел: ";
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }

    int count = 0;
    cout << "Елементи, значення яких збігається з порядковим номером: ";
    for (int i = 0; i < n; ++i) {
        int pos = i + 1; // порядковий номер (з 1)
        // Невеликий допуск 1e-9 корисний для порівняння дійсних чисел
        if (fabs(a[i] - pos) < 1e-9) {
            cout << a[i] << " (№" << pos << ") ";
            ++count;
        }
    }

    if (count == 0) {
        cout << "відсутні";
    }
    cout << "\nКількість таких елементів: " << count << endl;

    return 0;
}
