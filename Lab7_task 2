#include <iostream>
#include <vector>

using namespace std;

int main() {
    int rows, cols;
    cout << "Введіть кількість рядків та стовпців: ";
    cin >> rows >> cols;

    if (rows <= 0 || cols <= 0) {
        cout << "Розміри масиву мають бути додатними." << endl;
        return 0;
    }

    vector<vector<int>> a(rows, vector<int>(cols));
    cout << "Введіть елементи масиву (" << rows << "x" << cols << "):\n";
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            cin >> a[i][j];
        }
    }

    long long totalSum = 0;

    for (int i = 0; i < rows; ++i) {
        long long rowProduct = 1;
        for (int j = 0; j < cols; ++j) {
            rowProduct *= a[i][j];
        }
        totalSum += rowProduct;
    }

    cout << "Сума добутків усіх рядків: " << totalSum << endl;

    return 0;
}
